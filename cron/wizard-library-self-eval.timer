[Unit]
Description=Wizard Library Monthly Self-Eval Timer — 1st of month 8 AM local time

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: 1st of each month, 8:00 AM local time. Windows Task Scheduler wakes WSL at 7:59.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
OnCalendar=*-*-01 08:00:00
Persistent=true

[Install]
WantedBy=timers.target
