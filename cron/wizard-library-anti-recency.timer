[Unit]
Description=Wizard Library Anti-Recency Timer — Wednesday 8 AM local time weekly

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: Wednesday 8:00 AM local time weekly. Windows Task Scheduler wakes WSL at 7:59.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
# Wednesday chosen to offset from nightly sleep-loop (10:30 PM daily) and to
# provide a mid-week "memory refresh" before the work week's recency bias peaks.
OnCalendar=Wed *-*-* 08:00:00
Persistent=true

[Install]
WantedBy=timers.target
