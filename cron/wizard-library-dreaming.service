[Unit]
Description=Voidloom Unified Dream Pipeline — nightly phase-sequencer (nocturnal: seed-selection, NREM, REM, probe-QA, playbooks)
# After= also names the daytime dream unit: both share one lock (dream_pipeline.py
# lock_file), every timer here is Persistent=true, and a wake after 22:00 on a day
# that slept through 14:00 fires BOTH catch-ups in the same second (measured
# 2026-09-18 22:28:36: daytime won the lock, the nightly exited 1 'skipped', the
# night's cycle was lost). A Type=oneshot unit is 'activating' for as long as its
# ExecStart runs, so After= makes the nightly WAIT for the daytime's start job
# instead of racing it. One direction only (both would be a cycle systemd breaks
# silently); harmless where the daytime unit is not installed (an absent After=
# dependency is ignored). Memory #20269 (vl_dream_catchup_race).
After=network.target wizard-library-dream-daytime.service

[Service]
Type=oneshot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
# CUDA_VISIBLE_DEVICES is resolved by voidloom_device
# (WIZARD_CUDA_DEVICE, else the declaring env file, else 0).
# Set WIZARD_CUDA_DEVICE here only to override for this unit.
EnvironmentFile=-%h/.voidloom/wizard-library-env
ExecStart=/usr/bin/env python3 -u %h/.claude/memory/organs/dream_pipeline.py run %h/.claude/memory/claude_memory.db
WorkingDirectory=%h/.claude/memory
StandardOutput=journal
StandardError=journal
# Generous timeout: ~20 pairs x ~60s each = ~20 min max, plus pair selection.
TimeoutStartSec=1800
# STARVED (round 1): exit 79 = the thinker was unavailable (quota/auth/unreachable): nothing could be dreamt
# and nothing empty was written (organs/memory_dreaming.py EXIT_STARVED). Admitted, so a quota week is not a
# unit failure; the dream ledger's watch reads the night STARVED, never HEALTHY.
SuccessExitStatus=79
