[Unit]
Description=Wizard Library Sleep Loop Timer — nightly at 10:30 PM local time

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: 10:30 PM local time nightly. Windows Task Scheduler wakes WSL at 10:29.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
OnCalendar=*-*-* 22:30:00
Persistent=true

[Install]
WantedBy=timers.target
