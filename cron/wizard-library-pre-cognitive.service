[Unit]
Description=Wizard Library Pre-Cognitive Recall — refresh anticipation log + banner cache
After=network.target

[Service]
Type=oneshot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
# anticipate computes a focus vector via the embedding model -> GPU tier.
# This timer is the ONLY place the model loads for pre-cognitive recall;
# the session-start hook reads the cache this writes and NEVER loads a model.
# CUDA_VISIBLE_DEVICES is resolved by voidloom_device
# (WIZARD_CUDA_DEVICE, else the declaring env file, else 0).
# Set WIZARD_CUDA_DEVICE here only to override for this unit.
EnvironmentFile=-%h/.voidloom/wizard-library-env
ExecStart=/usr/bin/env python3 -u %h/.claude/memory/organs/precognitive_cache_refresh.py %h/.claude/memory/claude_memory.db --top-k 15 --ttl-hours 24
WorkingDirectory=%h/.claude/memory
StandardOutput=journal
StandardError=journal
# Budget: one anticipate run = model load (~5-50s) + recall + log write + cache.
# Generous ceiling so a cold model load on a busy GPU never trips the timer.
TimeoutStartSec=300
