[Unit]
Description=Wizard Library Cognitive Map Timer — weekly Sunday 18:00 local time

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: Sunday 18:00 local time weekly. Windows Task Scheduler wakes WSL at 17:59.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
# No conflict: Fri 08:30 skill-graduation, nightly 22:00 dreaming / 22:30 sleep / 23:00 backup.
OnCalendar=Sun *-*-* 18:00:00
Persistent=true

[Install]
WantedBy=timers.target
