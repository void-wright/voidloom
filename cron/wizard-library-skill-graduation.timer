[Unit]
Description=Wizard Library Skill Graduation Timer — weekly Friday 8:30 AM local time

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: Friday 8:30 AM local time weekly. Windows Task Scheduler wakes WSL at 8:29.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
OnCalendar=Fri *-*-* 08:30:00
Persistent=true

[Install]
WantedBy=timers.target
