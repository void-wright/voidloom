[Unit]
Description=Wizard Library Arcane Manifest — quarterly council co-authored prose narrative
After=network.target

[Service]
Type=oneshot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
# CUDA_VISIBLE_DEVICES is resolved by voidloom_device
# (WIZARD_CUDA_DEVICE, else the declaring env file, else 0).
# Set WIZARD_CUDA_DEVICE here only to override for this unit.
EnvironmentFile=-%h/.voidloom/wizard-library-env
ExecStart=/usr/bin/env python3 -u %h/.claude/memory/organs/arcane_manifest.py %h/.claude/memory/claude_memory.db --run --model-members haiku --model-synthesis opus --timeout 180
WorkingDirectory=%h/.claude/memory
StandardOutput=journal
StandardError=journal
# Budget: 4 members x ~120s + the synthesis ~300s + gather ~5s = ~13 min max.
# Add buffer for retry/timeout scenarios.
TimeoutStartSec=1200
