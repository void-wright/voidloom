[Unit]
Description=Wizard Library Whisper Digest Timer — Friday 8 AM local time weekly

[Timer]
# WSL2 HYBRID cron pattern (memory #3674):
# Primary: Friday 8:00 AM local time. Windows Task Scheduler wakes WSL at 7:59.
# Persistent=true catches missed runs (laptop lid closed, WSL suspended).
OnCalendar=Fri *-*-* 08:00:00
Persistent=true

[Install]
WantedBy=timers.target
