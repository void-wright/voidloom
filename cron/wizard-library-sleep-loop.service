[Unit]
Description=Wizard Library Sleep Loop — nightly memory consolidation cycle
After=network.target

[Service]
Type=oneshot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
# CUDA_VISIBLE_DEVICES is resolved by voidloom_device
# (WIZARD_CUDA_DEVICE, else the declaring env file, else 0).
# Set WIZARD_CUDA_DEVICE here only to override for this unit.
EnvironmentFile=-%h/.voidloom/wizard-library-env
ExecStart=/usr/bin/env python3 -u %h/.claude/memory/organs/claude_memory.py sleep --config %h/.voidloom/sleep-loop-config.json
WorkingDirectory=%h/.claude/memory
StandardOutput=journal
StandardError=journal
# The OUTER wall. The run enforces its own budget (budget_seconds in the sidecar sleep-loop-config.json, 540 packaged)
# on every platform -- launchd has no start timeout -- and closes its row; on SIGTERM from this wall it closes the
# row 'timeout' with the stage it reached. Keep this above budget_seconds.
TimeoutStartSec=600
