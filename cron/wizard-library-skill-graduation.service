[Unit]
Description=Wizard Library Skill Graduation — weekly procedural memory tier evaluation
After=network.target

[Service]
Type=oneshot
Environment=PYTHON_KEYRING_BACKEND=keyring.backends.null.Keyring
# CUDA_VISIBLE_DEVICES is resolved by voidloom_device
# (WIZARD_CUDA_DEVICE, else the declaring env file, else 0).
# Set WIZARD_CUDA_DEVICE here only to override for this unit.
EnvironmentFile=-%h/.voidloom/wizard-library-env
ExecStart=/usr/bin/env python3 -u %h/.claude/memory/organs/skill_graduation.py %h/.claude/memory/claude_memory.db --run --graduated-by cron
WorkingDirectory=%h/.claude/memory
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
